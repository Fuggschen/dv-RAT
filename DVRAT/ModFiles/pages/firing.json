{
  "id": "firing",
  "title": "Firing",
  "parent": "loco",
  "order": 15,
  "vars": { "view": "fire" },
  "rows": [
    { "type": "text", "style": "dim", "text": "Loading train data...", "when": "!train.loaded" },
    { "type": "text", "style": "dim", "text": "No locomotive in this train.", "when": "train.loaded && !loco.present" },
    { "type": "text", "style": "dim", "text": "No firing readings for this locomotive.", "when": "loco.present && !firing.present" },
    { "type": "text", "style": "dim", "text": "They show for a coal or oil fired steam engine while the Realistic Firing mod runs.", "when": "loco.present && !firing.present" },

    { "type": "buttons", "label": "Show", "when": "firing.present",
      "buttons": [
        { "label": "Fire", "set": { "view": "fire" }, "selectedWhen": "page.view=fire" },
        { "label": "Boiler", "set": { "view": "boiler" }, "selectedWhen": "page.view=boiler" },
        { "label": "Grate", "set": { "view": "fuel" }, "selectedWhen": "page.view=fuel", "when": "firing.coal" },
        { "label": "Burner", "set": { "view": "fuel" }, "selectedWhen": "page.view=fuel", "when": "firing.oil" },
        { "label": "Water", "set": { "view": "water" }, "selectedWhen": "page.view=water" },
        { "label": "Engine", "set": { "view": "engine" }, "selectedWhen": "page.view=engine" }
      ] },
    { "type": "field", "label": "Next", "labelWidth": 140, "lines": 2, "value": "{firing.advice.text}", "style": "warning",
      "when": "firing.advice.present && firing.advice.levelAct" },
    { "type": "field", "label": "Next", "labelWidth": 140, "lines": 2, "value": "{firing.advice.text}", "style": "highlight",
      "when": "firing.advice.present && firing.advice.levelWatch" },
    { "type": "field", "label": "Next", "labelWidth": 140, "lines": 2, "value": "{firing.advice.text}",
      "when": "firing.advice.present && !firing.advice.levelAct && !firing.advice.levelWatch" },
    { "type": "divider", "when": "firing.present" },

    { "type": "bar", "labelWidth": 140, "label": "Heat", "value": "firing.fire.heatBarPct",
      "text": "{firing.fire.heatPct:F0} %, {firing.fire.level}", "warnWhen": "firing.fire.levelAct",
      "when": "firing.present && page.view=fire" },
    { "type": "bar", "labelWidth": 140, "label": "Draft", "value": "firing.fire.draftBarPct", "max": "250",
      "text": "{firing.fire.draftPct:F0} %, {firing.fire.draftLevel}", "warnWhen": "firing.fire.draftLevelAct",
      "when": "firing.present && page.view=fire && firing.fire.lit" },
    { "type": "bar", "labelWidth": 140, "label": "Smoke", "value": "firing.fire.smokePct",
      "text": "{firing.fire.smokePct:F0} %", "warnWhen": "firing.fire.smokePct >= 90",
      "when": "firing.present && page.view=fire" },
    { "type": "pairs", "labelWidth": 140, "when": "firing.present && page.view=fire && firing.fire.hasTemperature",
      "items": [ ["Fire", "{firing.fire.state}"], ["Firebox", "{firing.fire.temperatureC:F0} °C"] ] },
    { "type": "field", "labelWidth": 140, "label": "Fire", "value": "{firing.fire.state}",
      "when": "firing.present && page.view=fire && !firing.fire.hasTemperature" },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=fire && firing.coalState.present && firing.coalState.hasCover",
      "items": [ ["Coal", "{firing.coalState.condition}, {firing.coalState.moisturePct:F1} % water"], ["Cover", "{firing.coalState.cover}"] ] },
    { "type": "field", "labelWidth": 140, "label": "Coal", "value": "{firing.coalState.condition}, {firing.coalState.moisturePct:F1} % water",
      "when": "page.view=fire && firing.coalState.present && !firing.coalState.hasCover" },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=fire && firing.stoker.present",
      "items": [ ["Stoker", "{firing.stoker.speedPct:F0} %"], ["Table", "{firing.stoker.tableKg:F0} kg"], ["Jets", "{firing.stoker.jetsBar:F1} bar"] ] },
    { "type": "text", "style": "warning", "text": "The stoker is jammed.", "when": "page.view=fire && firing.stoker.jammed" },
    { "type": "text", "style": "warning", "text": "Coal is piling up on the stoker table and wants raking.",
      "when": "page.view=fire && firing.stoker.tableLoaded" },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=fire && firing.fireman.present && firing.fireman.hasCall",
      "items": [ ["Fireman", "{firing.fireman.mode}"], ["Call", "{firing.fireman.call}, {firing.fireman.callLeftS:F0} s left"] ] },
    { "type": "field", "labelWidth": 140, "label": "Fireman", "value": "{firing.fireman.mode}",
      "when": "page.view=fire && firing.fireman.present && !firing.fireman.hasCall" },

    { "type": "bar", "labelWidth": 140, "label": "Pressure", "value": "firing.boiler.pressureBarPct",
      "text": "{firing.boiler.pressureBar:F1} / {firing.boiler.workingBar:F1} bar, {firing.boiler.pressureLevel}",
      "warnWhen": "firing.boiler.pressureLevelAct", "when": "page.view=boiler && firing.boiler.present" },
    { "type": "bar", "labelWidth": 140, "label": "Gauge glass", "value": "firing.boiler.glassBarPct",
      "text": "{firing.boiler.glassPct:F0} %, {firing.boiler.glassLevel}",
      "warnWhen": "firing.boiler.glassLevelAct", "when": "page.view=boiler && firing.boiler.present" },
    { "type": "field", "labelWidth": 140, "label": "Water", "value": "{firing.boiler.waterC:F0} °C, raising steam from cold",
      "when": "page.view=boiler && firing.boiler.hasWaterTemperature && firing.boiler.heating" },
    { "type": "field", "labelWidth": 140, "label": "Water", "value": "{firing.boiler.waterC:F0} °C",
      "when": "page.view=boiler && firing.boiler.hasWaterTemperature && !firing.boiler.heating" },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=boiler && firing.boiler.hasFouling",
      "items": [ ["Soot loss", "{firing.boiler.sootLossPct:F1} %"], ["Scale loss", "{firing.boiler.scaleLossPct:F1} %"] ] },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=boiler && firing.boiler.hasImpurities",
      "items": [ ["Impurities", "{firing.boiler.impuritiesPpm:F0} ppm"], ["Foam", "{firing.boiler.foamPct:F0} %"] ] },
    { "type": "field", "labelWidth": 140, "label": "Fusible plug", "value": "melted, the boiler is losing its steam into the firebox",
      "style": "warning", "when": "page.view=boiler && firing.boiler.plugMelted" },
    { "type": "field", "labelWidth": 140, "label": "Fusible plug", "value": "{firing.boiler.plugCoreC:F0} °C",
      "when": "page.view=boiler && firing.boiler.hasPlug && !firing.boiler.plugMelted" },
    { "type": "text", "style": "warning", "text": "The low water alarm is sounding.",
      "when": "page.view=boiler && firing.boiler.alarmSounding" },
    { "type": "text", "style": "dim", "text": "The mod gives no boiler readings for this engine.",
      "when": "firing.present && page.view=boiler && !firing.boiler.present" },

    { "type": "pairs", "labelWidth": 140, "when": "page.view=fuel && firing.grate.present && firing.grate.hasDoor",
      "items": [ ["Coal", "{firing.grate.coalKg:F0} kg"], ["Clinker", "{firing.grate.clinkerKg:F1} kg"], ["Door", "{firing.grate.doorPct:F0} %"] ] },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=fuel && firing.grate.present && !firing.grate.hasDoor",
      "items": [ ["Coal", "{firing.grate.coalKg:F0} kg"], ["Clinker", "{firing.grate.clinkerKg:F1} kg"] ] },
    { "type": "bar", "labelWidth": 140, "label": "Ashpan", "value": "firing.grate.ashpanPct",
      "text": "{firing.grate.ashpanPct:F0} %", "warnWhen": "firing.grate.ashpanFull",
      "when": "page.view=fuel && firing.grate.present" },
    { "type": "text", "style": "warning", "text": "The ashpan is full and wants emptying.",
      "when": "page.view=fuel && firing.grate.ashpanFull" },
    { "type": "text", "style": "warning", "text": "The fire is clinkered and wants cleaning.",
      "when": "page.view=fuel && firing.grate.needsCleaning" },
    { "type": "field", "labelWidth": 140, "label": "Running thin", "value": "{firing.grate.thinZone}", "style": "highlight",
      "when": "page.view=fuel && firing.grate.hasThinZone" },
    { "type": "list", "source": "firing.grate.rows", "rows": 3, "empty": "No grate zones.",
      "when": "page.view=fuel && firing.grate.present",
      "columns": [
        { "header": "Grate", "text": "{item.row}", "width": 140 },
        { "header": "Left", "text": "{item.left}", "flex": 1, "warnWhen": "item.leftThin" },
        { "header": "Center", "text": "{item.center}", "flex": 1, "warnWhen": "item.centerThin" },
        { "header": "Right", "text": "{item.right}", "flex": 1, "warnWhen": "item.rightThin" }
      ] },
    { "type": "text", "style": "dim", "text": "Each zone: coal on it, and how hard it burns. Front is at the tubes, back at the fire door.",
      "when": "page.view=fuel && firing.grate.present" },

    { "type": "pairs", "labelWidth": 140, "when": "page.view=fuel && firing.burner.present && firing.burner.hasStop",
      "items": [ ["Firing valve", "{firing.burner.firingValvePct:F0} %"], ["Stop", "{firing.burner.stopPct:F0} %"], ["Oil", "{firing.burner.feedKgPerS:F2} kg/s"] ] },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=fuel && firing.burner.present && !firing.burner.hasStop",
      "items": [ ["Firing valve", "{firing.burner.firingValvePct:F0} %"], ["Oil", "{firing.burner.feedKgPerS:F2} kg/s"] ] },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=fuel && firing.burner.present",
      "items": [ ["Atomizer", "{firing.burner.atomizerPct:F0} %"], ["Atomizing", "{firing.burner.atomizingPct:F0} %"] ] },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=fuel && firing.burner.present",
      "items": [ ["Oil heater", "{firing.burner.heaterPct:F0} %"], ["Oil", "{firing.burner.oilC:F0} °C"], ["Brick", "{firing.burner.brickC:F0} °C"] ] },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=fuel && firing.burner.present && firing.burner.onShedSteam",
      "items": [ ["Shed steam", "{firing.burner.steamLinePct:F0} % open"], ["Flue soot", "{firing.burner.flueSootPct:F0} %"] ] },
    { "type": "field", "labelWidth": 140, "label": "Flue soot", "value": "{firing.burner.flueSootPct:F0} %",
      "when": "page.view=fuel && firing.burner.present && !firing.burner.onShedSteam" },
    { "type": "heading", "text": "Lighting the fire", "when": "page.view=fuel && firing.burner.lighting" },
    { "type": "list", "source": "firing.burner.steps", "empty": "",
      "when": "page.view=fuel && firing.burner.lighting",
      "columns": [
        { "header": "", "text": "{item.mark}", "width": 40 },
        { "header": "Step", "text": "{item.title}", "width": 180 },
        { "header": "How", "text": "{item.how}", "flex": 1 }
      ] },

    { "type": "list", "source": "firing.injectors", "rows": 2, "empty": "",
      "when": "page.view=water && firing.hasInjectors",
      "columns": [
        { "header": "Injector", "text": "{item.name}", "width": 110 },
        { "header": "State", "text": "{item.state}", "width": 130, "warnWhen": "item.fault" },
        { "header": "Feed", "text": "{item.waterKgPerS:F1} kg/s", "width": 100, "align": "right" },
        { "header": "Setting", "text": "{item.setting}", "flex": 1 },
        { "header": "", "text": "{item.tender}", "width": 100, "style": "warning" }
      ] },
    { "type": "field", "labelWidth": 140, "label": "Overflow",
      "value": "{firing.overflow.waterKgPerS:F2} kg/s water, {firing.overflow.steamKgPerS:F2} kg/s steam wasted",
      "when": "page.view=water && firing.overflow.present" },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=water && firing.feedPump.present",
      "items": [ ["Feed pump", "{firing.feedPump.state}"], ["Feed", "{firing.feedPump.waterKgPerS:F1} kg/s, {firing.feedPump.temperatureC:F0} °C"] ] },
    { "type": "text", "style": "warning", "text": "The feed pump is not feeding as it should.",
      "when": "page.view=water && firing.feedPump.fault" },
    { "type": "text", "style": "dim", "text": "This engine's own injectors feed the boiler.",
      "when": "firing.present && page.view=water && !firing.hasInjectors && !firing.feedPump.present" },

    { "type": "pairs", "labelWidth": 140, "when": "page.view=engine && firing.engine.present",
      "items": [ ["Cutoff", "{firing.engine.cutoffPct:F0} %"], ["Steam chest", "{firing.engine.steamChestBar:F1} bar"], ["MEP", "{firing.engine.meanPressureBar:F1} bar"] ] },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=engine && firing.engine.present",
      "items": [ ["Steam use", "{firing.engine.steamKgPerS:F2} kg/s"], ["Condensing", "{firing.engine.condensingPct:F0} %"] ] },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=engine && firing.engine.superheated",
      "items": [ ["Superheat", "{firing.engine.superheatC:F0} °C"], ["Steam", "{firing.engine.steamC:F0} °C"] ] },
    { "type": "field", "labelWidth": 140, "label": "Superheat", "value": "saturated engine",
      "when": "page.view=engine && firing.engine.present && !firing.engine.superheated" },
    { "type": "pairs", "labelWidth": 140, "when": "page.view=engine && firing.booster.present",
      "items": [ ["Booster", "{firing.booster.state}"], ["Warm", "{firing.booster.warmPct:F0} %"] ] },
    { "type": "text", "style": "dim", "text": "The mod does not work this engine's cylinders.",
      "when": "firing.present && page.view=engine && !firing.engine.present && !firing.booster.present" }
  ]
}
